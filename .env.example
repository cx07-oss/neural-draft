# Documentation only: run.ps1 does not load .env files.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_SCENARIO_MODEL=qwen3:4b
OLLAMA_FORGE_MODEL=qwen3:1.7b
OLLAMA_BATTLE_MODEL=qwen3:1.7b
# Backward-compatible override for all three tasks:
# OLLAMA_MODEL=qwen3:4b
# NEURAL_OFFLINE=1
# SCENARIO_AI_TIMEOUT=45
FORGE_AI_TIMEOUT=20
# BATTLE_AI_TIMEOUT=4
# Optional alternate provider, explicitly selected:
# AI_PROVIDER=openai
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=provided-through-your-environment
